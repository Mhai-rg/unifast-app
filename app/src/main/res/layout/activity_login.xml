        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_lock_idle_lock" />

    <!-- Login Background -->
    <ImageView
        android:id="@+id/imageView21"
        android:layout_width="183dp"
        android:layout_height="112dp"
        android:layout_marginStart="102dp"
        android:layout_marginTop="559dp"
        android:layout_marginEnd="126dp"
        android:layout_marginBottom="243dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/button_onoff_indicator_off" />

    <ImageView
        android:id="@+id/imageView22"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_marginStart="117dp"
        android:layout_marginTop="411dp"
        android:layout_marginEnd="114dp"
        android:layout_marginBottom="402dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/dialog_holo_light_frame" />

    <ImageView
        android:id="@+id/imageView25"
        android:layout_width="180dp"
        android:layout_height="77dp"
        android:layout_marginStart="117dp"
        android:layout_marginTop="490dp"
        android:layout_marginEnd="114dp"
        android:layout_marginBottom="347dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/dialog_holo_light_frame" />

    <!-- Email Input -->
    <EditText
        android:id="@+id/editTextText"
        android:layout_width="148dp"
        android:layout_height="54dp"
        android:layout_marginStart="137dp"
        android:layout_marginTop="434dp"
        android:layout_marginEnd="126dp"
        android:layout_marginBottom="426dp"
        android:background="@android:color/transparent"
        android:hint="Enter email"
        android:inputType="textEmailAddress"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Password Input -->
    <EditText
        android:id="@+id/editTextText2"
        android:layout_width="144dp"
        android:layout_height="53dp"
        android:layout_marginStart="133dp"
        android:layout_marginTop="498dp"
        android:layout_marginEnd="134dp"
        android:layout_marginBottom="363dp"
        android:background="@android:color/transparent"
        android:hint="Enter password"
        android:inputType="textPassword"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LOGIN BUTTON -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="183dp"
        android:layout_height="55dp"
        android:layout_marginStart="102dp"
        android:layout_marginTop="583dp"
        android:layout_marginEnd="126dp"
        android:layout_marginBottom="276dp"
        android:backgroundTint="#79558F"
        android:text="LOGIN"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sign Up Text -->

    <!-- Terms and Conditions -->

    <!-- Menu Icon -->

    <Button
        android:id="@+id/btnSignUp"
        android:layout_width="263dp"
        android:layout_height="55dp"
        android:layout_marginStart="72dp"
        android:layout_marginTop="812dp"
        android:layout_marginEnd="76dp"
        android:layout_marginBottom="47dp"
        android:backgroundTint="@android:color/transparent"
        android:gravity="center"
        android:text="Don't have an account? Sign Up"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/editTextText5"
        android:layout_width="232dp"
        android:layout_height="58dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="856dp"
        android:layout_marginEnd="91dp"
        android:gravity="center"
        android:text="Terms &amp; conditions"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:layout_marginStart="367dp"
        android:layout_marginBottom="866dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_menu_sort_by_size" />

</androidx.constraintlayout.widget.ConstraintLayout>