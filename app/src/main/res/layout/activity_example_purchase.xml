<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4d5e7a"
    tools:context=".example_purchase">

    <!-- App Logo -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="190dp"
        android:layout_height="153dp"
        android:translationX="-26dp"
        android:translationY="-8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/app_logo" />

    <!-- App Name -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="126dp"
        android:layout_marginTop="48dp"
        android:fontFamily="cursive"
        android:text="Unifast"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header Divider -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="122dp"
        android:background="#D9D9D9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product Background Box -->
    <View
        android:id="@+id/boxMaleAccent"
        android:layout_width="0dp"
        android:layout_height="566dp"
        android:layout_marginTop="200dp"
        android:background="#AFAFBD"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product Image -->
    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="347dp"
        android:layout_height="368dp"
        android:layout_marginTop="137dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Product Divider 1 -->
    <View
        android:id="@+id/productDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="434dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product Name -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="443dp"
        android:fontFamily="@font/alegreya_sc"
        android:text="Female Top"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product Price -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="471dp"
        android:fontFamily="@font/alegreya_sc"
        android:text="₱ 367"
        android:textColor="#E91E63"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Divider Below Product Details -->
    <View
        android:id="@+id/productDivider2"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="512dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Size Label -->
    <TextView
        android:id="@+id/sizeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="530dp"
        android:fontFamily="@font/alegreya_sc"
        android:text="Select Size:"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Size Selection -->
    <RadioGroup
        android:id="@+id/sizeRadioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sizeLabel">

        <RadioButton
            android:id="@+id/sizeS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#E91E63"
            android:text="S"
            android:textColor="#000000" />

        <RadioButton
            android:id="@+id/sizeM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#E91E63"
            android:text="M"
            android:textColor="#000000" />

        <RadioButton
            android:id="@+id/sizeL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#E91E63"
            android:text="L"
            android:textColor="#000000" />

        <RadioButton
            android:id="@+id/sizeXL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#E91E63"
            android:text="XL"
            android:textColor="#000000" />

    </RadioGroup>

    <!-- Divider Below Size Selection -->
    <View
        android:id="@+id/productDivider3"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="620dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Quantity Label -->
    <TextView
        android:id="@+id/quantityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/alegreya_sc"
        android:text="Quantity:"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sizeRadioGroup" />

    <!-- Decrease Button -->
    <Button
        android:id="@+id/buttonDecrease"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#E0E0DE"
        android:text="-"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quantityLabel" />

    <!-- Quantity Number -->
    <TextView
        android:id="@+id/quantityNumber"
        android:layout_width="50dp"
        android:layout_height="45dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/buttonDecrease"
        app:layout_constraintTop_toTopOf="@id/buttonDecrease" />

    <!-- Increase Button -->
    <Button
        android:id="@+id/buttonIncrease"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:backgroundTint="#E0E0DE"
        android:text="+"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/quantityNumber"
        app:layout_constraintTop_toTopOf="@id/buttonDecrease" />

    <!-- Divider Below Quantity -->
    <View
        android:id="@+id/productDivider4"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="708dp"
        android:background="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Total Price Label -->
    <TextView
        android:id="@+id/totalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:fontFamily="@font/alegreya_sc"
        android:text="Total Price:"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonIncrease" />

    <!-- Total Price Amount -->
    <TextView
        android:id="@+id/totalPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/alegreya_sc"
        android:text="₱367"
        android:textColor="#E91E63"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/totalLabel" />

    <!-- Confirm Purchase Button -->

    <!-- Back Button -->
    <Button
        android:id="@+id/buttonConfirmPurchase"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#E91E63"
        android:text="CONFIRM PURCHASE"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/buttoninsplashscreen2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttoninsplashscreen2"
        android:layout_width="130dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#E0E0DE"
        android:text="Back"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>