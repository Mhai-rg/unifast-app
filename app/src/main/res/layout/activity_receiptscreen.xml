<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FF"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".receiptscreen">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/editTextText28"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Transaction Complete"
            android:textColor="#272947"
            android:textSize="27sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Lunaris and UniFast logo"
            android:scaleType="fitCenter"
            app:srcCompat="@mipmap/lunarislogodesign__foreground" />

        <ImageView
            android:id="@+id/imageView19"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Order successful"
            android:scaleType="fitCenter"
            app:srcCompat="@mipmap/checkdesign_foreground" />

        <TextView
            android:id="@+id/editTextText27"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="THANK YOU!!!"
            android:textColor="#6F51F0"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ORDER RECEIPT"
                android:textColor="#272947"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#DDDDDD" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">
                <TableRow><TextView android:id="@+id/editTextText2" style="@style/ReceiptLabel" android:text="Receipt Number:"/><TextView android:id="@+id/editTextText3" style="@style/ReceiptValue" android:text="N00067"/></TableRow>
                <TableRow><TextView android:id="@+id/editTextText9" style="@style/ReceiptLabel" android:text="Receipt Date:"/><TextView android:id="@+id/editTextText10" style="@style/ReceiptValue" android:text="10/19/26"/></TableRow>
                <TableRow><TextView android:id="@+id/editTextText11" style="@style/ReceiptLabel" android:text="Customer Name:"/><TextView android:id="@+id/editTextText12" style="@style/ReceiptValue" android:text="Jazz Montilano"/></TableRow>
                <TableRow><TextView android:id="@+id/editTextText14" style="@style/ReceiptLabel" android:text="Item Name:"/><TextView android:id="@+id/editTextText15" style="@style/ReceiptValue" android:text="Uniform"/></TableRow>
                <TableRow><TextView android:id="@+id/editTextText16" style="@style/ReceiptLabel" android:text="Quantity:"/><TextView android:id="@+id/editTextText17" style="@style/ReceiptValue" android:text="2 pcs"/></TableRow>
                <TableRow><TextView android:id="@+id/editTextText19" style="@style/ReceiptLabel" android:text="Unit price:"/><TextView android:id="@+id/editTextText21" style="@style/ReceiptValue" android:text="567.00"/></TableRow>
                <TableRow><TextView android:id="@+id/editTextText18" style="@style/ReceiptLabel" android:text="Total Amount:"/><TextView android:id="@+id/editTextText22" style="@style/ReceiptValue" android:text="1134.00"/></TableRow>
                <TableRow><TextView android:id="@+id/editTextText20" style="@style/ReceiptLabel" android:text="Payment Amount:"/><TextView android:id="@+id/editTextText23" style="@style/ReceiptValue" android:text="1134.00"/></TableRow>
            </TableLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#DDDDDD" />

            <TextView
                android:id="@+id/ProcessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Processing information"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/OrderProcessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your order is being processed."
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/Purchasebutton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:backgroundTint="#2D9AE3"
            android:minHeight="56dp"
            android:text="Make another purchase"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
