<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ItemLists">

    <!-- Background -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:srcCompat="@android:drawable/screen_background_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome Message -->
    <TextView
        android:id="@+id/welcomeMessage2"
        android:layout_width="247dp"
        android:layout_height="51dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/akaya_kanadaka"
        android:text="Welcome, Mhai!"
        android:textColor="#E1BBCB"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/topDivider2"
        android:layout_width="200dp"
        android:layout_height="2dp"
        android:layout_marginStart="124dp"
        android:layout_marginTop="72dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/middleDivider2"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="488dp"
        android:layout_marginEnd="8dp"
        android:background="#FBE1AE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="139dp"
        android:layout_height="132dp"
        app:srcCompat="@mipmap/applogoingreetingsscreen_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Box -->
    <View
        android:id="@+id/grayWhiteBox"
        android:layout_width="286dp"
        android:layout_height="297dp"
        android:layout_marginTop="132dp"
        android:background="#808080"
        android:foregroundTint="#FFFFFF"
        android:alpha="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496" />

    <View
        android:id="@+id/grayWhiteBox2"
        android:layout_width="286dp"
        android:layout_height="297dp"
        android:layout_marginTop="544dp"
        android:background="#808080"
        android:foregroundTint="#FFFFFF"
        android:alpha="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496" />

    <!-- Uniform -->
    <ImageView
        android:id="@+id/imageView28"
        android:layout_width="444dp"
        android:layout_height="407dp"
        app:srcCompat="@mipmap/femaleuniform_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="-17dp"
        android:translationY="113dp" />

    <ImageView
        android:id="@+id/imageView31"
        android:layout_width="412dp"
        android:layout_height="348dp"
        app:srcCompat="@mipmap/maleuniform_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="0dp"
        android:translationY="559dp" />

    <!-- Button -->
    <Button
        android:id="@+id/femaleButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:backgroundTint="#1AFFFFFF"
        android:text="FEMALE"
        android:textColor="#F0CB84"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="105dp"
        android:translationY="142dp" />

    <Button
        android:id="@+id/maleButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:backgroundTint="#1AFFFFFF"
        android:text="MALE"
        android:textColor="#5DE0E6"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="105dp"
        android:translationY="554dp" />

    <Button
        android:id="@+id/buttonInItemList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alpha="0.8"
        android:backgroundTint="#272947"
        android:text="Back"
        android:textColor="#E1BBCB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>