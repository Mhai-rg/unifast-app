<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4d5e7a"
    tools:context=".male_list">

    <Button
        android:id="@+id/buttonBackHome1"
        android:layout_width="160dp"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#E0E0DE"
        android:text="Back Home"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- App Logo -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="190dp"
        android:layout_height="153dp"
        android:translationX="-26dp"
        android:translationY="-8dp"
        app:srcCompat="@mipmap/app_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="126dp"
        android:layout_marginTop="48dp"
        android:fontFamily="cursive"
        android:text="Male List"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="122dp"
        android:background="#D9D9D9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Male Uniform Boxes -->
    <View
        android:id="@+id/boxMaleTopLeft"
        android:layout_width="195dp"
        android:layout_height="250dp"
        android:layout_marginTop="189dp"
        android:background="#AFAFBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/boxMaleTopRight"
        android:layout_width="195dp"
        android:layout_height="250dp"
        android:layout_marginStart="216dp"
        android:layout_marginTop="189dp"
        android:background="#AFAFBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/boxMaleBottomLeft"
        android:layout_width="195dp"
        android:layout_height="250dp"
        android:layout_marginTop="499dp"
        android:background="#AFAFBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/boxMaleBottomRight"
        android:layout_width="195dp"
        android:layout_height="250dp"
        android:layout_marginStart="216dp"
        android:layout_marginTop="499dp"
        android:background="#AFAFBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Male Top Image -->
    <ImageView
        android:id="@+id/imageView17"
        android:layout_width="276dp"
        android:layout_height="269dp"
        android:translationX="-40dp"
        android:translationY="159dp"
        app:srcCompat="@mipmap/male_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Male Pants Image -->
    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="292dp"
        android:layout_height="273dp"
        android:translationX="164dp"
        android:translationY="145dp"
        app:srcCompat="@mipmap/male_pants"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- P.E. Pants Image -->
    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="252dp"
        android:layout_height="288dp"
        android:translationX="195dp"
        android:translationY="439dp"
        app:srcCompat="@mipmap/pe_pants_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- P.E. Shirt Image -->
    <ImageView
        android:id="@+id/imageView19"
        android:layout_width="266dp"
        android:layout_height="279dp"
        android:translationX="-40dp"
        android:translationY="448dp"
        app:srcCompat="@mipmap/pe_top_male_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Male Top Button -->
    <Button
        android:id="@+id/buttonMaleTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="380dp"
        android:backgroundTint="#807783"
        android:fontFamily="@font/alegreya_sc"
        android:text="Male Top"
        android:textColor="#F8C9D6"
        android:textColorLink="#2196F3"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Male Pants Button -->
    <Button
        android:id="@+id/buttonMalePants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="236dp"
        android:layout_marginTop="380dp"
        android:backgroundTint="#807783"
        android:fontFamily="@font/alegreya_sc"
        android:text="Male Pants"
        android:textColor="#F8C9D6"
        android:textColorLink="#2196F3"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- P.E. Shirt Button -->
    <Button
        android:id="@+id/buttonPEShirt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="693dp"
        android:backgroundTint="#807783"
        android:fontFamily="@font/alegreya_sc"
        android:text="P.E. Shirt"
        android:textColor="#F8C9D6"
        android:textColorLink="#2196F3"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- P.E. Pants Button -->
    <Button
        android:id="@+id/buttonPEPants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="251dp"
        android:layout_marginTop="693dp"
        android:backgroundTint="#807783"
        android:fontFamily="@font/alegreya_sc"
        android:text="P.E. Pants"
        android:textColor="#F8C9D6"
        android:textColorLink="#2196F3"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>