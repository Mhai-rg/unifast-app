<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GreetingsScreen">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:srcCompat="@android:drawable/screen_background_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Picture -->
    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="143dp"
        android:layout_height="125dp"
        app:srcCompat="@mipmap/profilepicture_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/topDivider"
        android:layout_width="200dp"
        android:layout_height="2dp"
        android:layout_marginStart="124dp"
        android:layout_marginTop="72dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/middleDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="488dp"
        android:background="#FBE1AE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Box -->
    <View
        android:id="@+id/yellowBox"
        android:layout_width="299dp"
        android:layout_height="336dp"
        android:layout_marginStart="108dp"
        android:layout_marginTop="132dp"
        android:background="#F0CB84"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/blueBox"
        android:layout_width="313dp"
        android:layout_height="322dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="548dp"
        android:background="#5DE0E6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Text -->
    <TextView
        android:id="@+id/welcomeMessage"
        android:layout_width="247dp"
        android:layout_height="51dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/akaya_kanadaka"
        android:text="Welcome, Mhai!"
        android:textColor="#E1BBCB"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/academyDescription1"
        android:layout_width="235dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="175dp"
        android:layout_marginTop="132dp"
        android:fontFamily="sans-serif-medium"
        android:text="At Lunaris Academy, we are committed to fostering excellence, integrity, and lifelong learning. Our school provides a supportive environment"
        android:textColor="#000000"
        android:textSize="19sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/academyDescription2"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="110dp"
        android:layout_marginTop="266dp"
        android:fontFamily="sans-serif-medium"
        android:text="where students are encouraged to grow academically, develop strong character, and prepare for a bright future. Through this platform, we strive to make school services more accessible and convenient for every student."
        android:textColor="#000000"
        android:textSize="21sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/uniFastDescription1"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="23dp"
        android:layout_marginTop="551dp"
        android:fontFamily="sans-serif-medium"
        android:text="UniFast is the official uniform ordering application of Lunaris Academy. It is designed to simplify the"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/uniFastDescription2"
        android:layout_width="337dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="670dp"
        android:fontFamily="sans-serif-medium"
        android:text="process of purchasing school uniforms by providing an organized catalog, detailed product information, and a seamless ordering experience. Our goal is to make obtaining official school attire faster, more convenient, and accessible for every student."
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageView32"
        android:layout_width="218dp"
        android:layout_height="246dp"
        app:srcCompat="@mipmap/academylogo_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeMessage"
        android:layout_marginTop="8dp"
        tools:ignore="DuplicateConstraints" />

    <ImageView
        android:id="@+id/imageView62"
        android:layout_width="236dp"
        android:layout_height="221dp"
        app:srcCompat="@mipmap/applogoingreetingsscreen_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="198dp"
        android:layout_marginTop="490dp" />

    <!-- Button -->
    <Button
        android:id="@+id/button1InGreetings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:alpha="0.8"
        android:backgroundTint="#272947"
        android:text="Make a Purchase"
        android:textColor="#E1BBCB"
        app:layout_constraintTop_toBottomOf="@id/uniFastDescription2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>