<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="vertical" android:background="#000000"><androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/main" android:minHeight="1100dp">

            <!-- Profile Picture -->
            <ImageView android:id="@+id/imageView4" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginStart="16dp" android:layout_marginTop="20dp" android:scaleType="fitCenter" app:srcCompat="@mipmap/profilepicture_foreground" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

            <!-- Welcome Message -->
            <TextView android:id="@+id/welcomeMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="16dp" android:fontFamily="@font/akaya_kanadaka" android:text="Welcome, Mhai!" android:textColor="#E1BBCB" android:textSize="28sp" app:layout_constraintStart_toEndOf="@id/imageView4" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/imageView4" app:layout_constraintBottom_toBottomOf="@id/imageView4"/>

            <!-- Welcome Divider -->
            <View android:id="@+id/topDivider" android:layout_width="0dp" android:layout_height="2dp" android:layout_marginStart="100dp" android:layout_marginEnd="16dp" android:background="#FFFFFF" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/imageView4" android:layout_marginTop="8dp"/>

            <!-- Academy Yellow Box -->
            <View android:id="@+id/yellowBox" android:layout_width="0dp" android:layout_height="390dp" android:layout_marginStart="88dp" android:layout_marginEnd="12dp" android:layout_marginTop="24dp" android:background="#F0CB84" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/topDivider"/>

            <!-- Academy Description 1 -->
            <TextView android:id="@+id/academyDescription1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="76dp" android:layout_marginEnd="10dp" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:text="At Lunaris Academy, we are committed to fostering excellence, integrity, and lifelong learning. Our school provides a supportive environment" android:textColor="#000000" android:textSize="17sp" app:layout_constraintStart_toStartOf="@id/yellowBox" app:layout_constraintEnd_toEndOf="@id/yellowBox" app:layout_constraintTop_toTopOf="@id/yellowBox"/>

            <!-- Academy Description 2 -->
            <TextView android:id="@+id/academyDescription2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginTop="8dp" android:fontFamily="sans-serif-medium" android:text="where students are encouraged to grow academically, develop strong character, and prepare for a bright future. Through this platform, we strive to make school services more accessible and convenient for every student." android:textColor="#000000" android:textSize="18sp" app:layout_constraintStart_toStartOf="@id/yellowBox" app:layout_constraintEnd_toEndOf="@id/yellowBox" app:layout_constraintTop_toBottomOf="@id/academyDescription1"/>

            <!-- Academy Logo -->
            <ImageView android:id="@+id/imageView32" android:layout_width="145dp" android:layout_height="155dp" android:scaleType="fitCenter" app:srcCompat="@mipmap/academylogo_foreground" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/yellowBox"/>

            <!-- Middle Divider -->
            <View android:id="@+id/middleDivider" android:layout_width="0dp" android:layout_height="2dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginTop="24dp" android:background="#FBE1AE" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/yellowBox"/>

            <!-- UniFast Cyan Box -->
            <View android:id="@+id/blueBox" android:layout_width="0dp" android:layout_height="350dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="24dp" android:background="#5DE0E6" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/middleDivider"/>

            <!-- UniFast Description -->
            <TextView android:id="@+id/uniFastDescription1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="100dp" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:text="UniFast is the official uniform ordering application of Lunaris Academy. It is designed to simplify the process of purchasing school uniforms by providing an organized catalog, detailed product information, and a seamless ordering experience. Our goal is to make obtaining official school attire faster, more convenient, and accessible for every student." android:textColor="#000000" android:textSize="18sp" app:layout_constraintStart_toStartOf="@id/blueBox" app:layout_constraintEnd_toEndOf="@id/blueBox" app:layout_constraintTop_toTopOf="@id/blueBox"/>

            <!-- UniFast Logo -->
            <ImageView android:id="@+id/imageView62" android:layout_width="130dp" android:layout_height="130dp" android:scaleType="fitCenter" app:srcCompat="@mipmap/applogoingreetingsscreen_foreground" app:layout_constraintEnd_toEndOf="@id/blueBox" app:layout_constraintTop_toTopOf="@id/blueBox"/>

            <!-- Make a Purchase Button -->
            <Button android:id="@+id/button1InGreetings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="24dp" android:alpha="0.8" android:backgroundTint="#272947" android:text="Make a Purchase" android:textColor="#E1BBCB" app:layout_constraintTop_toBottomOf="@id/blueBox" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
