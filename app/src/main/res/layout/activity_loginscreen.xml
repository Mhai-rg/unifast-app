        tools:layout_editor_absoluteX="34dp"
        tools:layout_editor_absoluteY="495dp" />

    <EditText
        android:id="@+id/editTextTextEmailAddress2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
