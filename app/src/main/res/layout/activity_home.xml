<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4d5e7a"
    tools:context=".Home">

    <!-- App Logo -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="190dp"
        android:layout_height="153dp"
        app:srcCompat="@mipmap/app_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="-26dp"
        android:translationY="-8dp" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="cursive"
        android:text="Welcome to UniFast!"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="126dp"
        android:layout_marginTop="48dp" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#D9D9D9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="122dp" />

    <!-- Female Uniform Background Box -->
    <View
        android:id="@+id/boxFemale"
        android:layout_width="407dp"
        android:layout_height="250dp"
        android:background="#EEEEEE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="189dp" />

    <!-- Male Uniform Background Box -->
    <View
        android:id="@+id/boxMale"
        android:layout_width="409dp"
        android:layout_height="250dp"
        android:background="#EEEEEE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="527dp" />

    <!-- Female Box Accent -->
    <View
        android:id="@+id/boxFemaleAccent"
        android:layout_width="195dp"
        android:layout_height="250dp"
        android:background="#AFAFBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="216dp"
        android:layout_marginTop="189dp" />

    <!-- Male Box Accent -->
    <View
        android:id="@+id/boxMaleAccent"
        android:layout_width="195dp"
        android:layout_height="250dp"
        android:background="#AFAFBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="527dp" />

    <!-- Female Top -->
    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="271dp"
        android:layout_height="228dp"
        app:srcCompat="@mipmap/female_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="142dp"
        android:layout_marginTop="160dp" />

    <!-- Female Skirt -->
    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="217dp"
        android:layout_height="189dp"
        app:srcCompat="@mipmap/female_skirt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="238dp"
        android:layout_marginTop="280dp" />

    <!-- Male Top -->
    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="242dp"
        android:layout_height="220dp"
        app:srcCompat="@mipmap/male_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="-43dp"
        android:layout_marginTop="496dp" />

    <!-- Male Pants -->
    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="236dp"
        android:layout_height="276dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="556dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/male_pants" />


    <!-- Shop Female Button -->
    <Button
        android:id="@+id/buttonShopFemale"
        android:layout_width="173dp"
        android:layout_height="70dp"
        android:backgroundTint="#E0E0DE"
        android:text="Shop Female"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="273dp" />

    <!-- Shop Male Button -->
    <Button
        android:id="@+id/buttonShopMale"
        android:layout_width="173dp"
        android:layout_height="70dp"
        android:backgroundTint="#E0E0DE"
        android:text="Shop Male"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="216dp"
        android:layout_marginTop="616dp" />

    <!-- Back Button -->
    <Button
        android:id="@+id/buttonBackHome"
        android:layout_width="173dp"
        android:layout_height="70dp"
        android:layout_marginEnd="268dp"
        android:layout_marginBottom="12dp"
        android:background="@android:color/transparent"
        android:backgroundTint="#4d5e7a"
        android:text="◀ Back"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>