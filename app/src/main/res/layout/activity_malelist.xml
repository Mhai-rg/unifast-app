<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MaleList">

    <!-- Background -->
    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:srcCompat="@android:drawable/screen_background_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Section Title -->
    <TextView
        android:id="@+id/welcomeMessage3"
        android:layout_width="247dp"
        android:layout_height="51dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/akaya_kanadaka"
        android:text="Male Section"
        android:textColor="#5DE0E6"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Label -->
    <TextView
        android:id="@+id/labelTop"
        android:layout_width="100dp"
        android:layout_height="51dp"
        android:layout_marginStart="72dp"
        android:layout_marginTop="148dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="Top"
        android:textColor="#5DE0E6"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- P.E. Shirt Label -->
    <TextView
        android:id="@+id/labelPeShirt"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="512dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="P.E. Shirt"
        android:textColor="#5DE0E6"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pants Label -->
    <TextView
        android:id="@+id/labelPants"
        android:layout_width="200dp"
        android:layout_height="51dp"
        android:layout_marginStart="248dp"
        android:layout_marginTop="148dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="Pants"
        android:textColor="#5DE0E6"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- P.E. Pants Label -->
    <TextView
        android:id="@+id/labelPePants"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:layout_marginStart="212dp"
        android:layout_marginTop="512dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="P.E. Pants"
        android:textColor="#5DE0E6"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Divider -->
    <View
        android:id="@+id/topDivider4"
        android:layout_width="170dp"
        android:layout_height="2dp"
        android:layout_marginStart="124dp"
        android:layout_marginTop="72dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="139dp"
        android:layout_height="132dp"
        app:srcCompat="@mipmap/applogoingreetingsscreen_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Middle Divider -->
    <View
        android:id="@+id/middleDivider2"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="488dp"
        android:layout_marginEnd="8dp"
        android:background="#FBE1AE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Uniform Box 1 -->
    <View
        android:id="@+id/grayBox1"
        android:layout_width="180dp"
        android:layout_height="301dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="150dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Uniform Box 3 -->
    <View
        android:id="@+id/grayBox3"
        android:layout_width="180dp"
        android:layout_height="301dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="512dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Uniform Box 2 -->
    <View
        android:id="@+id/grayBox2"
        android:layout_width="180dp"
        android:layout_height="301dp"
        android:layout_marginStart="212dp"
        android:layout_marginTop="150dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Uniform Box 4 -->
    <View
        android:id="@+id/grayBox4"
        android:layout_width="194dp"
        android:layout_height="300dp"
        android:layout_marginStart="212dp"
        android:layout_marginTop="512dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Purchase Top -->
    <Button
        android:id="@+id/buttonPurchaseTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="472dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#5DE0E6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.175"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Purchase P.E. Shirt -->
    <Button
        android:id="@+id/buttonPurchasePeShirt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="108dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#5DE0E6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.175"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Purchase Pants -->
    <Button
        android:id="@+id/buttonPurchasePants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="472dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#5DE0E6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.827"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Purchase P.E. Pants -->
    <Button
        android:id="@+id/buttonPurchasePePants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="108dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#5DE0E6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.827"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Back Button -->
    <Button
        android:id="@+id/buttonBackItemList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alpha="0.8"
        android:backgroundTint="#272947"
        android:text="Back"
        android:textColor="#E1BBCB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Male P.E. Pants -->
    <ImageView
        android:id="@+id/imageView43"
        android:layout_width="338dp"
        android:layout_height="339dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/pe_pants_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox4"
        app:layout_constraintBottom_toBottomOf="@id/grayBox4"
        app:layout_constraintStart_toStartOf="@id/grayBox4"
        app:layout_constraintEnd_toEndOf="@id/grayBox4" />

    <!-- Male P.E. Shirt -->
    <ImageView
        android:id="@+id/imageView48"
        android:layout_width="304dp"
        android:layout_height="298dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/pe_top_male_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox3"
        app:layout_constraintBottom_toBottomOf="@id/grayBox3"
        app:layout_constraintStart_toStartOf="@id/grayBox3"
        app:layout_constraintEnd_toEndOf="@id/grayBox3" />

    <!-- Male Top -->
    <ImageView
        android:id="@+id/imageView51"
        android:layout_width="271dp"
        android:layout_height="302dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/top_male_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox1"
        app:layout_constraintBottom_toBottomOf="@id/grayBox1"
        app:layout_constraintStart_toStartOf="@id/grayBox1"
        app:layout_constraintEnd_toEndOf="@id/grayBox1" />

    <!-- Male Pants -->
    <ImageView
        android:id="@+id/imageView54"
        android:layout_width="327dp"
        android:layout_height="366dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/pants_male_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox2"
        app:layout_constraintBottom_toBottomOf="@id/grayBox2"
        app:layout_constraintStart_toStartOf="@id/grayBox2"
        app:layout_constraintEnd_toEndOf="@id/grayBox2" />

</androidx.constraintlayout.widget.ConstraintLayout>