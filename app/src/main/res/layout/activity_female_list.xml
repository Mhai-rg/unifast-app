<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".female_list">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="UniFast logo"
                android:scaleType="fitCenter"
                app:srcCompat="@mipmap/applogoingreetingsscreen_foreground" />
            <TextView
                android:id="@+id/welcomeMessage4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/akaya_kanadaka"
                android:text="Female Section"
                android:textColor="#E1BBCB"
                android:textSize="30sp" />
        </LinearLayout>

        <View
            android:id="@+id/topDivider4"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:background="#FFFFFF" />

        <!-- First row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="#BDBDBD"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="6dp">
                <TextView
                    android:id="@+id/femaleLabelTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Top"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />
                <ImageView
                    android:id="@+id/imageView50"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Female uniform top"
                    app:srcCompat="@mipmap/top_female_foreground" />
                <Button
                    android:id="@+id/buttonPurchaseTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#969696"
                    android:text="Purchase"
                    android:textColor="#E1BBCB" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="#BDBDBD"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="6dp">
                <TextView
                    android:id="@+id/femaleLabelSkirt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Skirt"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />
                <ImageView
                    android:id="@+id/imageView49"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Female uniform skirt"
                    app:srcCompat="@mipmap/skirt_female_foreground" />
                <Button
                    android:id="@+id/buttonPurchaseSkirt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#969696"
                    android:text="Purchase"
                    android:textColor="#E1BBCB" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/middleDivider2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp"
            android:background="#FBE1AE" />

        <!-- Second row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="#BDBDBD"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="6dp">
                <TextView
                    android:id="@+id/femaleLabelPeShirt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="P.E. Shirt"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />
                <ImageView
                    android:id="@+id/imageView42"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Female P.E. shirt"
                    app:srcCompat="@mipmap/pe_uniform_female_foreground" />
                <Button
                    android:id="@+id/buttonPurchasePeShirt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#969696"
                    android:text="Purchase"
                    android:textColor="#E1BBCB" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="#BDBDBD"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="6dp">
                <TextView
                    android:id="@+id/femaleLabelPePants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="P.E. Pants"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />
                <ImageView
                    android:id="@+id/imageView41"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Female P.E. pants"
                    app:srcCompat="@mipmap/pe_pants_foreground" />
                <Button
                    android:id="@+id/buttonPurchasePePants"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#969696"
                    android:text="Purchase"
                    android:textColor="#E1BBCB" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/buttonBackItemList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:backgroundTint="#272947"
            android:text="Back"
            android:textColor="#E1BBCB" />
    </LinearLayout>
</ScrollView>
