 <?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".female_list">

    <!-- BACKGROUND -->
    <ImageView
        android:id="@+id/imageView38"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/screen_background_dark" />

    <!-- TEXT -->
    <TextView
        android:id="@+id/welcomeMessage4"
        android:layout_width="247dp"
        android:layout_height="51dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/akaya_kanadaka"
        android:text="Female Section"
        android:textColor="#E1BBCB"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ITEM LABELS -->
    <TextView
        android:id="@+id/femaleLabelTop"
        android:layout_width="100dp"
        android:layout_height="51dp"
        android:layout_marginStart="72dp"
        android:layout_marginTop="148dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="Top"
        android:textColor="#E1BBCB"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/femaleLabelPeShirt"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="512dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="P.E. Shirt"
        android:textColor="#E1BBCB"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/femaleLabelSkirt"
        android:layout_width="200dp"
        android:layout_height="51dp"
        android:layout_marginStart="248dp"
        android:layout_marginTop="148dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="Skirt"
        android:textColor="#E1BBCB"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/femaleLabelPePants"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:layout_marginStart="212dp"
        android:layout_marginTop="512dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="P.E. Pants"
        android:textColor="#E1BBCB"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- DIVIDERS -->
    <View
        android:id="@+id/topDivider4"
        android:layout_width="190dp"
        android:layout_height="2dp"
        android:layout_marginStart="124dp"
        android:layout_marginTop="72dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/middleDivider2"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="488dp"
        android:layout_marginEnd="8dp"
        android:background="#FBE1AE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LOGO -->
    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="139dp"
        android:layout_height="132dp"
        app:srcCompat="@mipmap/applogoingreetingsscreen_foreground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOXES -->
    <View
        android:id="@+id/grayBox1"
        android:layout_width="180dp"
        android:layout_height="301dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="150dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/grayBox3"
        android:layout_width="180dp"
        android:layout_height="301dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="512dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/grayBox2"
        android:layout_width="180dp"
        android:layout_height="301dp"
        android:layout_marginStart="212dp"
        android:layout_marginTop="150dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/grayBox4"
        android:layout_width="180dp"
        android:layout_height="301dp"
        android:layout_marginStart="212dp"
        android:layout_marginTop="512dp"
        android:background="#CCE0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- IMAGE -->
    <ImageView
        android:id="@+id/imageView50"
        android:layout_width="294dp"
        android:layout_height="308dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/top_female_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox1"
        app:layout_constraintBottom_toBottomOf="@id/grayBox1"
        app:layout_constraintStart_toStartOf="@id/grayBox1"
        app:layout_constraintEnd_toEndOf="@id/grayBox1" />

    <ImageView
        android:id="@+id/imageView49"
        android:layout_width="284dp"
        android:layout_height="233dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/skirt_female_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox2"
        app:layout_constraintBottom_toBottomOf="@id/grayBox2"
        app:layout_constraintStart_toStartOf="@id/grayBox2"
        app:layout_constraintEnd_toEndOf="@id/grayBox2" />

    <ImageView
        android:id="@+id/imageView42"
        android:layout_width="304dp"
        android:layout_height="298dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/pe_uniform_female_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox3"
        app:layout_constraintBottom_toBottomOf="@id/grayBox3"
        app:layout_constraintStart_toStartOf="@id/grayBox3"
        app:layout_constraintEnd_toEndOf="@id/grayBox3" />

    <ImageView
        android:id="@+id/imageView41"
        android:layout_width="338dp"
        android:layout_height="339dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/pe_pants_foreground"
        app:layout_constraintTop_toTopOf="@id/grayBox4"
        app:layout_constraintBottom_toBottomOf="@id/grayBox4"
        app:layout_constraintStart_toStartOf="@id/grayBox4"
        app:layout_constraintEnd_toEndOf="@id/grayBox4" />

    <!-- PURCHASE BUTTONS -->
    <Button
        android:id="@+id/buttonPurchaseTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="472dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#E1BBCB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.175"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonPurchasePeShirt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="108dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#E1BBCB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.175"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonPurchaseSkirt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="472dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#E1BBCB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.827"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonPurchasePePants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="108dp"
        android:alpha="0.8"
        android:backgroundTint="#969696"
        android:text="Purchase"
        android:textColor="#E1BBCB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.827"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- BACK BUTTON -->
    <Button
        android:id="@+id/buttonBackItemList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alpha="0.8"
        android:backgroundTint="#272947"
        android:text="Back"
        android:textColor="#E1BBCB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>