        <activity android:name=".payment_screen" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".receiptscreen" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".WelcomeScreen" android:exported="false" android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
